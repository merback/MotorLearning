\begin{tikzpicture}[y=0.80pt, x=0.80pt, yscale=-1, xscale=1, inner sep=0pt, outer sep=0pt,font=\Large]
	% coordinate system
	%\path[draw=black][thick]  (2+0,2+100   ) -- (2+0 ,2+100+75);
	%\path[draw=black][thick]  (  0,0+100+75) -- (2+75,0+100+75);
	

    \path[draw=TUDa-9d,thick, fill=TUDa-9a, fill opacity=0.2] (20, 0) arc (-90:0:130) -- (85,130) arc (0:-90:65) -- cycle;

    % Arrow
	\path[draw=black,thick, xshift=-3, yshift=3] (26.7600,114.8700) .. controls (40,95) and (47.3200,89.6700) .. (55,81)  node [midway, fill=white] {$\textbf{F}^{(\textbf{P}_1)}$};
	\path[fill=black, xshift=-3, yshift=3] (51, 76) -- (58, 87) -- (61, 78) -- cycle;
    \node[] at (135,30) {$\Omega^{(\textbf{P}_1)}$};

  
    	% ref domain
    \begin{scope}[shift={(-28,0)}]
    	\path[draw=TUDa-2d,thick, fill=TUDa-2a,fill opacity=0.2] (2,100+25) rectangle (2+50.0000,100+75);
    
    % grids
    \foreach \i in {1,...,3}{
		\path[draw=TUDa-2d] (2+\i*50/4,125) -- (2+\i*50/4,175);
		\path[draw=TUDa-2d] (2,175-\i*50/4) -- (2+50,175-\i*50/4);
	}
  
%    \node[] at (0,185) {\scriptsize ($u_1,v_1$)};
%    \node[] at (52,185) {\scriptsize ($u_N,v_1$)};
    
    % Points
    \foreach \i in {0,...,4}{
        \foreach \j in {0, ..., 4}{
            \node at (2+\i*50/4, 175 - \j*50/4) [circle, fill=black, inner sep=1pt] {};
        }
	}
      \end{scope} 
    

    %physical

     \foreach \i in {1,...,3}{
		\path[draw=TUDa-9d] (20, \i*65/4) arc (-90:0:130-\i*65/4);
		\path[draw=TUDa-9d] ({20+65*cos(-90+\i*90/4)},{130+65*sin(-90+\i*90/4)}) -- ({20+130*cos(-90+\i*90/4)},{130+130*sin(-90+\i*90/4)});
	}
    
    \foreach \i in {0,...,4}{
        \foreach \j in {0, ..., 4}{
            \node at ({20+(130-\i*65/4)*sin(\j*90/4)}, {130-(130-\i*65/4)*cos(\j*90/4)}) 
                [circle, fill=black, inner sep=1pt] {};
        }
	}
	
%    \node[] at (20,73) {\scriptsize ($x_1,y_1$)};
%    \node[] at (85,138) {\scriptsize ($x_N,y_1$)};
    
    
    \begin{scope}[rotate=-90,xslant=0.5, yslant=.4, scale=0.7, shift={(-120,-170)}]
    	
    	\path[draw=TUDa-9d,thick, fill=TUDa-9a, fill opacity=0.2] (20, 0) arc (-90:0:130) -- (85,130) arc (0:-90:65) -- cycle;
    	
    	 \foreach \i in {1,...,3}{
    		\path[draw=TUDa-9d] (20, \i*65/4) arc (-90:0:130-\i*65/4);
    		\path[draw=TUDa-9d] ({20+65*cos(-90+\i*90/4)},{130+65*sin(-90+\i*90/4)}) -- ({20+130*cos(-90+\i*90/4)},{130+130*sin(-90+\i*90/4)});
    	}
    	
    	   \foreach \i in {0,...,4}{
    		\foreach \j in {0, ..., 4}{
    			\node at ({20+(130-\i*65/4)*sin(\j*90/4)}, {130-(130-\i*65/4)*cos(\j*90/4)}) 
    			[circle, fill=black, inner sep=1pt] {};
    		}
    	}
    \end{scope}
    \begin{scope}[rotate=-90,shift={(-150,-150)}]
    \path[draw=black,thick, xshift=-3, yshift=3] (26.7600,114.8700) .. controls (40,95) and (47.3200,89.6700) .. (55,81)  node [midway, fill=white] {$\textbf{F}^{(\textbf{P}_2)}$};
    \path[fill=black, xshift=-3, yshift=3] (51, 76) -- (58, 87) -- (61, 78) -- cycle;
    \end{scope}
     \node[] at (-115,50) {$\Omega^{(\textbf{P}_2)}$};

